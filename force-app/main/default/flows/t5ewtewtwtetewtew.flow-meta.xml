    <decisions>
        <description>Determines whether the promotion fulfillment action is credit points or issue voucher.</description>
        <name>Credit_Points_or_Issue_Voucher</name>
        <label>Credit Points or Issue Voucher?</label>
        <locationX>358</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Issue_Voucher</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Issue Voucher</defaultConnectorLabel>
        <rules>
            <name>Credit_Points_for_Accruals_Having_Promotions_with_Points_Factor</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Promotion.FulfillmentAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CreditPoints</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Promotion.IsPointsWithFactor</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Promotion.TransactionJournalType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accrual</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Points_to_Credit_for_Accruals_Having_Promotion_with_Points_Factor</targetReference>
            </connector>
            <label>Credit Points for Accruals Having Promotions with Points Factor</label>
        </rules>
        <rules>
            <name>Credit_Points_for_Redemptions_Having_Promotions_with_Points_Factor</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Promotion.FulfillmentAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CreditPoints</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Promotion.IsPointsWithFactor</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Promotion.TransactionJournalType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Redemption</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Points_to_Credit_for_Redemptions_Having_Promotion_with_Points_Factor</targetReference>
            </connector>
            <label>Credit Points for Redemptions Having Promotions with Points Factor</label>
        </rules>
        <rules>
            <name>Credit_Points_for_Promotion_without_Points_Factor</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Promotion.FulfillmentAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CreditPoints</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Promotion.IsPointsWithFactor</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Points_to_Credit_for_Promotions_without_Points_Factor</targetReference>
            </connector>
            <label>Credit Points for Promotion without Points Factor</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether the member has reached the cumulative usage target.</description>
        <name>Has_Member_Reached_the_Cumulative_Usage_Target</name>
        <label>Has Member Reached the Cumulative Usage Target?</label>
        <locationX>916</locationX>
        <locationY>317</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Reached</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Update_Progress_For_Cumulative_Promotion_Usage.updatedCumulativeUsageCompleted</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Update_Progress_For_Cumulative_Promotion_Usage.cumulativeUsageTarget</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Credit_Points_or_Issue_Voucher</targetReference>
            </connector>
            <label>Reached</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether the loyalty promotion type is cumulative and the associated transaction journal is for accrual.</description>
        <name>Is_the_Promotion_Cumulative_and_for_an_Accrual</name>
        <label>Is the Promotion Cumulative and for an Accrual?</label>
        <locationX>452</locationX>
        <locationY>56</locationY>
        <defaultConnector>
            <targetReference>Credit_Points_or_Issue_Voucher</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No (Default)</defaultConnectorLabel>
        <rules>
            <name>Cumulative_and_Accrual</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Promotion.TransactionJournalType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accrual</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Promotion.LoyaltyPromotionType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cumulative</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Progress_For_Cumulative_Promotion_Usage</targetReference>
            </connector>
            <label>Cumulative and Accrual</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>Stores the points to be credited for accrual transaction when the IsPointsWithFactor value is set to true for the promotion record.</description>
        <name>PointsForAccrual</name>
        <dataType>Number</dataType>
