public with sharing class VoucherDefinitionTriggerHandler extends TriggerHandler {
  public VoucherDefinitionTriggerHandler() {
    this.setMaxLoopCount(2);
  }

  public override void afterInsert() {
    ApexLogger logger = new ApexLogger(ApexLogger.JobType.ACTION);
    logger.logging(VoucherDefinitionTriggerHandler.class.getName());
    logger.setRequestDatetime(Datetime.now());

    List<VoucherDefinition> newList = (List<VoucherDefinition>) Trigger.new;

    Set<Id> vdIds = new Set<Id>();
    for (VoucherDefinition vd : newList) {
      vdIds.add(vd.Id);
    }

    List<VoucherDefinition> vdList = [
      SELECT
        Id,
        OwnerId,
        IsDeleted,
        Name,
        CreatedDate,
        CreatedById,
        LastModifiedDate,
        LastModifiedById,
        SystemModstamp,
        LastViewedDate,
        LastReferencedDate,
        Description,
        PartnerAccountId,
        Type,
        ExpirationType,
        EffectiveDate,
        ExpirationDate,
        ExpirationPeriodUnit,
        ExpirationPeriod,
        FaceValue,
        DiscountPercent,
        ProductId,
        IsActive,
        LoyaltyProgramId,
        ProductDerivedFieldId,
        ProductCategoryDerivedFieldId,
        CostPerVoucher,
        IsPartialRedeemable,
        CodePrefix,
        CodeSuffix,
        AutogeneratedCodeLength,
        ImageUrl,
        HasTimeBasedVoucherPeriod,
        EffectiveDateTime,
        ExpirationDateTime,
        CouponManNo__c,
        CouponTypeCode__c,
        ResponsibleDepartment__c,
        InsertId__c,
        VoucherCategoryId__c,
        brand__c,
        ResponsiblePerson__c,
        AccountId__c,
        AccountId__r.CompanyCode__c
      FROM VoucherDefinition
      WHERE Id IN :vdIds
    ];

    Set<String> successIds = new Set<String>();
    Set<String> failIds = new Set<String>();
    List<String> failMsgs = new List<String>();

    try {
      if (vdList == null || vdList.isEmpty()) {
        logger.setStatus('SUCCESS');
        logger.setDescription('scope is empty');
        return;
      }

      logger.setScopedIds((List<SObject>) vdList, 'Id');

      for (VoucherDefinition vd : vdList) {
        try {
          // ! ERP 동기화 X
          // ErpCouponMasterReqDto.IssueRequest req = new ErpCouponMasterReqDto.IssueRequest(vd);

          // logger.setRequestBody(JSON.serialize(req));

          // System.enqueueJob(new ErpCouponJob(ErpCouponJob.Operation.CREATE_MASTER, req, new ErpCouponAsyncCallback(), vd.Id));

          successIds.add((String) vd.Id);
        } catch (CustomException ce) {
          failIds.add((String) vd.Id);
          failMsgs.add('Id=' + vd.Id + ' | ' + ce.getMessage());
        } catch (Exception ex) {
          failIds.add((String) vd.Id);
          failMsgs.add('Id=' + vd.Id + ' | ' + ex.getMessage());
        }
      }

      failIds.removeAll(successIds);

      // status: SUCCESS / PARTIAL / ERROR
      if (!failIds.isEmpty() && !successIds.isEmpty()) {
        logger.setStatus('PARTIAL');
      } else if (!failIds.isEmpty()) {
        logger.setStatus('ERROR');
      } else {
        logger.setStatus('SUCCESS');
      }

      logger.setDescription('ERP coupon master create done. total=' + vdList.size() + ', success=' + successIds.size() + ', fail=' + failIds.size());
    } catch (Exception e) {
      logger.createExceptionLog(e);
      logger.setStatus('ERROR');
      logger.setDescription('Handler failed: ' + e.getMessage());
    } finally {
      if (!successIds.isEmpty()) {
        logger.setSuccessRecordIds(successIds);
      }
      if (!failIds.isEmpty()) {
        logger.setFailedRecordIds(failIds);
      }
      if (!failMsgs.isEmpty()) {
        logger.setErrorMessage(String.join(failMsgs, ' | '));
      }

      logger.setResponseDatetime(Datetime.now());
      logger.addLog();
      ApexLogger.insertLogs();
    }
  }

  public override void afterDelete() {
