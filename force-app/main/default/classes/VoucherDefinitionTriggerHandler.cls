    logger.logging(VoucherDefinitionTriggerHandler.class.getName());
    logger.setRequestDatetime(Datetime.now());

    List<VoucherDefinition> oldList = (List<VoucherDefinition>) Trigger.old;

    Set<String> successIds = new Set<String>();
    Set<String> failIds = new Set<String>();
    List<String> failMsgs = new List<String>();

    try {
      if (oldList == null || oldList.isEmpty()) {
        logger.setStatus('SUCCESS');
        logger.setDescription('scope is empty');
        return;
      }

      logger.setScopedIds((List<SObject>) oldList, 'Id');

      for (VoucherDefinition vd : oldList) {
        try {
          ErpCouponMasterReqDto.DeleteRequest req = new ErpCouponMasterReqDto.DeleteRequest(vd);

          logger.setRequestBody(JSON.serialize(req));

          // ! ERP 동기화 x
          // System.enqueueJob(new ErpCouponJob(ErpCouponJob.Operation.DELETE_MASTER, req, new ErpCouponAsyncCallback(), vd.Id));

          successIds.add((String) vd.Id);
        } catch (Exception ex) {
          failIds.add((String) vd.Id);
          failMsgs.add('Id=' + vd.Id + ' | ' + ex.getMessage());
        }
      }

      failIds.removeAll(successIds);

      if (!failIds.isEmpty() && !successIds.isEmpty()) {
        logger.setStatus('PARTIAL');
      } else if (!failIds.isEmpty()) {
        logger.setStatus('ERROR');
      } else {
        logger.setStatus('SUCCESS');
      }

      logger.setDescription(
        'ERP coupon master delete enqueue done. total=' + oldList.size() + ', success=' + successIds.size() + ', fail=' + failIds.size()
      );
    } finally {
      if (!successIds.isEmpty()) {
        logger.setSuccessRecordIds(successIds);
      }
      if (!failIds.isEmpty()) {
        logger.setFailedRecordIds(failIds);
      }
      if (!failMsgs.isEmpty()) {
        logger.setErrorMessage(String.join(failMsgs, ' | '));
      }

      logger.setResponseDatetime(Datetime.now());
      logger.addLog();
      ApexLogger.insertLogs();
    }
  }

  public override void afterUpdate() {
    ApexLogger logger = new ApexLogger(ApexLogger.JobType.ACTION);
    logger.logging(VoucherDefinitionTriggerHandler.class.getName());
    logger.setRequestDatetime(Datetime.now());

    Map<Id, VoucherDefinition> newMap = (Map<Id, VoucherDefinition>) Trigger.newMap;
    Map<Id, VoucherDefinition> oldMap = (Map<Id, VoucherDefinition>) Trigger.oldMap;

    Set<String> successIds = new Set<String>();
    Set<String> failIds = new Set<String>();
    List<String> failMsgs = new List<String>();

    try {
      if (newMap == null || newMap.isEmpty()) {
        logger.setStatus('SUCCESS');
        logger.setDescription('scope is empty');
        return;
      }

      // logger.setScopedIds((List<SObject>) newList, 'Id');
      logger.setScopedIds((List<SObject>) new List<VoucherDefinition>(newMap.values()), 'Id');

      for (Id vdId : newMap.keySet()) {
        VoucherDefinition vdNew = newMap.get(vdId);
        VoucherDefinition vdOld = oldMap.get(vdId);

        try {
          // 1) 시스템 원복/내부 처리면 enqueue 금지
          if (vdNew.ErpSyncSkip__c == true) {
            System.debug('if (vdNew.ErpSyncSkip__c == true) 진입');
            continue;
          }

          // 2) ERP 동기화 대상 필드가 변경된 경우만 enqueue
          if (!isErpSyncRelevantChange(vdOld, vdNew)) {
            System.debug('if (!isErpSyncRelevantChange(vdOld, vdNew)) 진입');
            continue;
          }

          List<VoucherDefinition> vdList = [
            SELECT
              Id,
              OwnerId,
              IsDeleted,
              Name,
              CreatedDate,
              CreatedById,
              LastModifiedDate,
              LastModifiedById,
              SystemModstamp,
              LastViewedDate,
              LastReferencedDate,
              Description,
              PartnerAccountId,
              Type,
              ExpirationType,
              EffectiveDate,
              ExpirationDate,
              ExpirationPeriodUnit,
              ExpirationPeriod,
              FaceValue,
              DiscountPercent,
              ProductId,
              IsActive,
              LoyaltyProgramId,
              ProductDerivedFieldId,
              ProductCategoryDerivedFieldId,
              CostPerVoucher,
              IsPartialRedeemable,
              CodePrefix,
              CodeSuffix,
              AutogeneratedCodeLength,
              ImageUrl,
              HasTimeBasedVoucherPeriod,
              EffectiveDateTime,
              ExpirationDateTime,
              CouponManNo__c,
              CouponTypeCode__c,
              ResponsibleDepartment__c,
              InsertId__c,
              VoucherCategoryId__c,
              brand__c,
              ResponsiblePerson__c,
              AccountId__c,
              AccountId__r.CompanyCode__c
            FROM VoucherDefinition
            WHERE Id = :vdId
            LIMIT 1
          ];

          ErpCouponMasterReqDto.UpdateRequest req = new ErpCouponMasterReqDto.UpdateRequest(vdList[0]);
          // ErpCouponMasterReqDto.UpdateRequest req = new ErpCouponMasterReqDto.UpdateRequest(vdNew);

          logger.setRequestBody(JSON.serialize(req));

          System.debug('vdNew : ' + vdNew);
          System.debug('vdOld : ' + vdOld);

          // ErpCouponJob에 UPDATE_MASTER가 없다면 CREATE_MASTER로 통일해도 됨(ERP가 upsert라면)
          // ! ERP 동기화 x
          // System.enqueueJob(new ErpCouponJob(ErpCouponJob.Operation.UPDATE_MASTER, req, new ErpCouponAsyncCallback(), vdId, vdOld));

          successIds.add((String) vdId);
        } catch (Exception ex) {
          failIds.add((String) vdId);
          failMsgs.add('Id=' + vdId + ' | ' + ex.getMessage());
        }
      }

      failIds.removeAll(successIds);

      if (!failIds.isEmpty() && !successIds.isEmpty()) {
        logger.setStatus('PARTIAL');
      } else if (!failIds.isEmpty()) {
        logger.setStatus('ERROR');
      } else {
        logger.setStatus('SUCCESS');
      }

      logger.setDescription(
        'ERP coupon master update enqueue done. total=' + newMap.size() + ', success=' + successIds.size() + ', fail=' + failIds.size()
      );
    } finally {
      if (!successIds.isEmpty()) {
        logger.setSuccessRecordIds(successIds);
      }
      if (!failIds.isEmpty()) {
        logger.setFailedRecordIds(failIds);
      }
      if (!failMsgs.isEmpty()) {
        logger.setErrorMessage(String.join(failMsgs, ' | '));
      }

      logger.setResponseDatetime(Datetime.now());
      logger.addLog();
      ApexLogger.insertLogs();
    }
  }

  /**
   * ERP에 반영해야 하는 변경인지 판단
   * - ERP Coupon Master Issue/Update 요청 DTO에서 참조하는 필드만 비교
   * - 제어용 필드(ErpSyncSkip__c 등)는 비교 대상에서 제외
   */
  @TestVisible
  private static Boolean isErpSyncRelevantChange(VoucherDefinition oldVd, VoucherDefinition newVd) {
    if (oldVd == null || newVd == null) {
      return true;
    }

    // =========================
    // ERP 요청 DTO에서 참조하는 필드들만 비교
    // =========================

    // 쿠폰 명
    if (oldVd.Name != newVd.Name)
      return true;

    // 쿠폰 관리 번호
    if (oldVd.CouponManNo__c != newVd.CouponManNo__c)
      return true;

    // 쿠폰 구분 코드
    if (oldVd.CouponTypeCode__c != newVd.CouponTypeCode__c)
      return true;

    // 브랜드 코드
    if (oldVd.brand__c != newVd.brand__c)
      return true;

    // 회사(룩업)
    if (oldVd.AccountId__c != newVd.AccountId__c)
      return true;

    // 쿠폰 시작/종료 번호
    if (oldVd.CodePrefix != newVd.CodePrefix)
      return true;
    if (oldVd.CodeSuffix != newVd.CodeSuffix)
      return true;

    // 유효기간 타입
    if (oldVd.ExpirationType != newVd.ExpirationType)
      return true;

    // 유효 시작/종료일
    if (oldVd.EffectiveDate != newVd.EffectiveDate)
      return true;
    if (oldVd.ExpirationDate != newVd.ExpirationDate)
      return true;

    // 유효 개월 수
    if (oldVd.ExpirationPeriod != newVd.ExpirationPeriod)
      return true;

    // 쿠폰 비고
    if (oldVd.Description != newVd.Description)
      return true;

    // 할인율 / 할인금액
    if (oldVd.DiscountPercent != newVd.DiscountPercent)
      return true;
    if (oldVd.FaceValue != newVd.FaceValue)
      return true;

    // 담당부서 / 담당자 / 등록자
    if (oldVd.ResponsibleDepartment__c != newVd.ResponsibleDepartment__c)
      return true;
    if (oldVd.ResponsiblePerson__c != newVd.ResponsiblePerson__c)
      return true;
    if (oldVd.InsertId__c != newVd.InsertId__c)
      return true;

    // (선택) ERP에서 활성/비활성 개념을 관리한다면 포함
    if (oldVd.IsActive != newVd.IsActive)
      return true;

    return false;
  }
}