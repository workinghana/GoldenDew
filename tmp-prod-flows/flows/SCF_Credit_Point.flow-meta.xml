RIGHT(&quot;0&quot; &amp; TEXT(MONTH({!get050.ExpiryDate})), 2) &amp;
RIGHT(&quot;0&quot; &amp; TEXT(DAY({!get050.ExpiryDate})), 2)</expression>
    </formulas>
    <formulas>
        <description>유효 종료일 (YYYYMMDD)</description>
        <name>dt_limit_end</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR({!ExpiryMinus1})) &amp;
RIGHT(&quot;0&quot; &amp; TEXT(MONTH({!ExpiryMinus1})), 2) &amp;
RIGHT(&quot;0&quot; &amp; TEXT(DAY({!ExpiryMinus1})), 2)</expression>
    </formulas>
